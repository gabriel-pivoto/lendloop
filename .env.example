# ---------------------------------------------------------------------------
# Next.js (.env.local). `npx convex dev` writes the two Convex values for you.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ---------------------------------------------------------------------------
# Convex deployment env (NOT in .env.local; set with `npx convex env set`):
#   CLERK_JWT_ISSUER_DOMAIN     https://<your-app>.clerk.accounts.dev
#   ADMIN_EMAILS                comma-separated verified emails that get admin
#   LENDLOOP_HMAC_SECRET        same value as below
#   N8N_LOAN_EVENT_WEBHOOK_URL  <n8n public url>/webhook/lendloop-loan-event
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Docker Compose (.env next to docker-compose.yml)
# ---------------------------------------------------------------------------
# openssl rand -hex 32
LENDLOOP_HMAC_SECRET=
# openssl rand -hex 32  (encrypts n8n credentials at rest; never change it later)
N8N_ENCRYPTION_KEY=
# Where n8n reaches Convex HTTP actions (the .convex.site URL).
# Local backend from the host: http://host.docker.internal:3211
CONVEX_SITE_URL=https://<deployment>.convex.site
# Public base URL of n8n, used in webhook URLs (tunnel URL when Convex is in the cloud)
N8N_PUBLIC_URL=http://localhost:5678/
LENDLOOP_MAIL_FROM=LendLoop <no-reply@lendloop.local>
